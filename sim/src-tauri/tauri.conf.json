{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDM26 Driver-in-Loop",
  "version": "0.6.3",
  "identifier": "com.sundevilmotorsports.fsaesim",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SDM26 Driver-in-Loop - FSAE Michigan 2026",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": false,
        "backgroundColor": "#0b0d10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["hset"],
        "name": "Helios setup",
        "description": "Helios vehicle setup",
        "role": "Editor",
        "mimeType": "application/x-helios-setup"
      }
    ],
    "shortDescription": "First-person SDM26 FSAE simulator",
    "longDescription": "First-person driving simulator for Sun Devil Motorsports' SDM26 on the 2026 FSAE Michigan autocross and endurance courses."
  }
}
